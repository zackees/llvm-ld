# ripgrep/Grep default exclusions. These payload directories are LLVM's optimizer, backend, and
# TableGen inputs: compiled into llvm_ld.dll but inert during a non-LTO link, and off-limits for
# local edits (see CLAUDE.md, PROVENANCE.md). Searching them buries the linker hot path in noise.
# Pass an explicit path or `rg --no-ignore` when you actually need them.
llvm-project/llvm/lib/Target/
llvm-project/llvm/lib/CodeGen/
llvm-project/llvm/lib/Transforms/
llvm-project/llvm/lib/Analysis/
llvm-project/llvm/lib/IR/
llvm-project/llvm/lib/Frontend/
llvm-project/llvm/lib/Support/UnicodeNameToCodepointGenerated.cpp
llvm-project/llvm/include/llvm/IR/Intrinsics*.td
llvm-project/llvm/utils/
llvm-project/libc/
provenance/llvm-source-closure.json
provenance/libxml2-files.json
